**Часть 2. Ячейка 63 — Mean-target encoding**

```python
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import average_precision_score

def fit_target_encoder(X_train, y_train):
    global_mean = y_train.mean()
    mappings = {}

    for col in X_train.columns:
        stats = (
            pd.DataFrame({col: X_train[col], "target": y_train})
            .groupby(col)["target"]
            .mean()
        )
        mappings[col] = stats.to_dict()

    return mappings, global_mean

def apply_target_encoder(X, mappings, global_mean):
    X_enc = pd.DataFrame(index=X.index)
    for col in X.columns:
        X_enc[col] = X[col].map(mappings[col]).fillna(global_mean)
    return X_enc

start_timer = time.time()

mappings, global_mean = fit_target_encoder(X_train, y_train)
X_train_ctr = apply_target_encoder(X_train, mappings, global_mean)
X_test_ctr = apply_target_encoder(X_test, mappings, global_mean)

model = LogisticRegression(max_iter=100000, random_state=777)
model.fit(X_train_ctr, y_train)
y_pred = model.predict_proba(X_test_ctr)[:, 1]

elapsed = time.time() - start_timer

print("AUC-PR:", average_precision_score(y_test, y_pred))
print("Train time:", elapsed)
```

