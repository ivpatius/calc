```python
from sklearn.model_selection import StratifiedKFold

def fit_target_encoder_smoothed(X_train, y_train, C=10.0):
    global_mean = y_train.mean()
    mappings = {}

    for col in X_train.columns:
        stats = (
            pd.DataFrame({col: X_train[col], "target": y_train})
            .groupby(col)["target"]
            .agg(["sum", "count"])
        )

        smooth = (stats["sum"] + C * global_mean) / (stats["count"] + C)
        mappings[col] = smooth.to_dict()

    return mappings, global_mean

def apply_target_encoder_smoothed(X, mappings, global_mean):
    X_enc = pd.DataFrame(index=X.index)
    for col in X.columns:
        X_enc[col] = X[col].map(mappings[col]).fillna(global_mean)
    return X_enc

# Аккуратно выбираем C на внутренней CV только по train
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=777)
C_grid = [0.5, 1, 2, 5, 10, 20, 50]

cv_scores = []
X_train_reset = X_train.reset_index(drop=True)
y_train_reset = y_train.reset_index(drop=True)

for smooth_C in C_grid:
    fold_scores = []

    for tr_idx, val_idx in cv.split(X_train_reset, y_train_reset):
        X_tr = X_train_reset.iloc[tr_idx]
        X_val = X_train_reset.iloc[val_idx]
        y_tr = y_train_reset.iloc[tr_idx]
        y_val = y_train_reset.iloc[val_idx]

        mappings, global_mean = fit_target_encoder_smoothed(X_tr, y_tr, C=smooth_C)
        X_tr_enc = apply_target_encoder_smoothed(X_tr, mappings, global_mean)
        X_val_enc = apply_target_encoder_smoothed(X_val, mappings, global_mean)

        model = LogisticRegression(max_iter=100000, random_state=777)
        model.fit(X_tr_enc, y_tr)
        y_val_pred = model.predict_proba(X_val_enc)[:, 1]

        fold_scores.append(average_precision_score(y_val, y_val_pred))

    cv_scores.append((smooth_C, np.mean(fold_scores)))

best_smooth_C = max(cv_scores, key=lambda x: x[1])[0]
print("CV scores:", cv_scores)
print("Best smoothing C:", best_smooth_C)

mappings, global_mean = fit_target_encoder_smoothed(X_train, y_train, C=best_smooth_C)
X_train_sm = apply_target_encoder_smoothed(X_train, mappings, global_mean)
X_test_sm = apply_target_encoder_smoothed(X_test, mappings, global_mean)

