**Часть 1. Ячейка 38 — исправленная калибровочная кривая**

```python
def plot_calibration_curve(y_test, preds):
    bin_middle_points = []
    bin_real_ratios = []

    n_bins = 10
    for i in range(n_bins):
        l = 1.0 / n_bins * i
        r = 1.0 / n_bins * (i + 1)

        # правильный центр бина
        middle = (l + r) / 2

        # в последний бин включаем правую границу
        if i < n_bins - 1:
            mask = (preds >= l) & (preds < r)
        else:
            mask = (preds >= l) & (preds <= r)

        # пустые бины пропускаем
        if mask.sum() == 0:
            continue

        bin_middle_points.append(middle)

        # правильная доля положительного класса
        bin_real_ratios.append(np.mean(y_test[mask] == 1))

    plt.figure(figsize=(6, 6))
    plt.plot(bin_middle_points, bin_real_ratios, marker="o")
    plt.ylim([-0.05, 1.05])
    plt.xlim([-0.05, 1.05])
    plt.grid()
```

